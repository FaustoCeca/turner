# URL pública del sitio, sin barra final. Con el dominio gratis de Vercel: https://TU-PROYECTO.vercel.app
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Turner

# Clave para cifrar los tokens de Mercado Pago guardados en la base. Generala con: openssl rand -base64 32
APP_SECRET=

# Postgres en tu VPS. Ej: postgres://turnero:CLAVE@IP_DEL_VPS:5432/turnero?sslmode=require
# Si se omite en desarrollo se usa PGlite embebido en .data/
DATABASE_URL=
# Certificado del servidor Postgres (PEM, se puede pegar con \n). Si está, la conexión TLS lo verifica.
# DATABASE_CA_CERT=
# Conexiones por instancia (por defecto 2 en Vercel, 5 en local)
# DATABASE_POOL_SIZE=

# Limpieza diaria (/api/cron): Vercel envía "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ── Mercado Pago ──────────────────────────────────────────────
# Aplicación de Mercado Pago para que cada negocio vincule su cuenta por OAuth (cobro de señas)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta de webhooks (Tus integraciones → Webhooks)
MP_WEBHOOK_SECRET=
# Token de la cuenta de la plataforma para cobrar las suscripciones de los negocios
MP_PLATFORM_ACCESS_TOKEN=
# Pagos simulados: activos por defecto en desarrollo. 1 = forzar, 0 = desactivar
# MP_MOCK=

# Página de ejemplo enlazada desde el inicio (opcional)
# NEXT_PUBLIC_DEMO_SLUG=barberia-demo
